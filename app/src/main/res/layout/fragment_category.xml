<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chalk"
    tools:context=".ui.category.CategoryFragment">

    <!-- ============ Top bar: back button + title ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_mint"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/symbol_back"
            android:textColor="@color/pitch_green_dark"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/navy"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="@id/btn_back"
            tools:text="Golden Era · 1974–1990" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/topbar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topbar" />

    <!-- ============ Tabs (horizontally scrollable on narrow phones) ============ -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topbar_divider">

        <LinearLayout
            android:id="@+id/tab_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tab_all"
                style="@style/CategoryTab"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_active"
                android:text="@string/tab_all"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tab_finals"
                style="@style/CategoryTab"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_inactive"
                android:text="@string/tab_finals"
                android:textColor="@color/pitch_green_dark" />

            <TextView
                android:id="@+id/tab_players"
                style="@style/CategoryTab"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_inactive"
                android:text="@string/tab_players"
                android:textColor="@color/pitch_green_dark" />

            <TextView
                android:id="@+id/tab_records"
                style="@style/CategoryTab"
                android:background="@drawable/bg_pill_inactive"
                android:text="@string/tab_records"
                android:textColor="@color/pitch_green_dark" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============ List of tournaments in the era ============ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_topics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_scroll"
        tools:listitem="@layout/item_topic_card" />

</androidx.constraintlayout.widget.ConstraintLayout>