<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/chalk"
    android:fillViewport="true"
    tools:context=".ui.results.ResultsFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ============== HERO (dark header with the score) =============== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_results_gradient"
            android:paddingStart="26dp"
            android:paddingTop="44dp"
            android:paddingEnd="26dp"
            android:paddingBottom="34dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text_trophy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/symbol_trophy"
                android:textSize="44sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/text_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="@color/gold"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_trophy"
                tools:text="1986 - Mexico"/>

            <TextView
                android:id="@+id/text_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_label"/>

            <TextView
                android:id="@+id/text_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/white_65"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_score"
                tools:text="Great result - almost perfect"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/pitch_divider"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:background="@color/pitch_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hero"/>

        <!-- ============== Three stats box =============== -->
        <LinearLayout
            android:id="@+id/stat_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="22dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pitch_divider">

            <include
                android:id="@+id/stat_accuracy"
                layout="@layout/item_stat_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"/>
            <include
                android:id="@+id/stat_time"
                layout="@layout/item_stat_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"/>
            <include
                android:id="@+id/stat_points"
                layout="@layout/item_stat_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- =============== Buttons ==================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/btn_next_quiz"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/pitch_green"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stat_row"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/btn_home"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:backgroundTint="@color/white"
            app:cornerRadius="14dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_next_quiz"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>